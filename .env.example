# 复制为 .env 后填入自己的接口；chmod 600 .env
# 服务端读取，密钥不会进入浏览器、镜像或导出文件。

# --- 文本生成（火山方舟 ARK，或任意 OpenAI 兼容网关）---
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_DEFAULT_MODEL=

# --- 语义检索：向量化 ---
SILICON_EMBEDDING_API_KEY=
SILICON_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SILICON_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
SILICON_EMBEDDING_DIMENSIONS=1024

# --- 语义检索：重排（可留空，检索会降级为原文匹配）---
SILICON_RERANK_API_KEY=
SILICON_RERANK_BASE_URL=https://api.siliconflow.cn/v1
SILICON_RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# --- 运行时（一般不用改；容器内由 compose 覆盖）---
# PORT=4310
# HOST=127.0.0.1
# WORKBENCH_DATA=data
# TRUST_PROXY=1
# NO_WORKER=1
